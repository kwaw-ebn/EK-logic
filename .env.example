# Copy to .env for Docker Compose. Never commit real values.
DATABASE_URL=postgresql+psycopg://eklogic:development-only@db:5432/eklogic
APP_ENV=development
FRONTEND_URL=http://localhost:3000
API_INTERNAL_URL=http://api:8000
STORAGE_DIR=/app/data
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Generate a Fernet key with the command in docs/deployment.md. Leave blank if Google is unused.
CREDENTIAL_KEY=
# Optional private S3-compatible bucket (otherwise the persistent local volume is used).
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
